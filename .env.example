# InsightForge AI Configuration
# Copy this to .env and fill in your API key

# Google Gemini API Key (required for live AI)
# Get yours: https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Backend
BACKEND_URL=http://localhost:8000
LOG_LEVEL=INFO

# Models
EMBEDDING_MODEL=all-MiniLM-L6-v2
LLM_MODEL=gemini-2.5-flash

# Data
DB_PATH=data/db/insightforge.db
FAISS_INDEX_PATH=data/faiss/index.faiss
FAISS_METADATA_DB=data/faiss/metadata.sqlite
UPLOAD_DIR=data/uploads
